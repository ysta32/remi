# Copy to detector/.env.local and fill in privately. Never commit actual values.
OPENAI_API_KEY=
# Set explicitly to a Responses model supporting strict structured output.
OPENAI_EXTRACT_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REPEAT_THRESHOLD=0.85
# Standalone aliases: OPENAI_EXTRACTION_MODEL, EMBEDDING_MODEL.
# Team names above take precedence when both are defined.
