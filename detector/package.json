{
  "name": "remi-repeat-detector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check cli.mjs && for file in src/*.mjs tests/*.mjs; do node --check \"$file\" || exit; done"
  },
  "types": "./src/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    }
  }
}
