# Chert / LiveKit configuration for Remi.
#
# Copy this to .env.local and fill in the real values yourself:
#     cp env.local.template .env.local && chmod 0600 .env.local
#
# .env.local is git-ignored. Never commit, print, log, screenshot, or paste
# these values into a chat. `chert doctor` verifies them without showing them.
# These are four SEPARATE credentials; none of them authorizes the others.

# --- LiveKit project (all three must come from ONE project) ---
LIVEKIT_URL=YOUR_LIVEKIT_URL
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# --- Agent registration name: must match the name your agent registers with,
# --- and must not collide with another team's name on the same LiveKit project.
AGENT_NAME=remi

# --- Model key used by the voice agent ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- Chert SDK, iMessage send surface ---
CHERT_BASE_URL=YOUR_CHERT_BASE_URL
CHERT_API_KEY=YOUR_CHERT_API_KEY

# --- Chert SDK, FaceTime read surface ---
CHERT_FACETIME_URL=YOUR_CHERT_FACETIME_URL
CHERT_FACETIME_TOKEN=YOUR_CHERT_FACETIME_TOKEN

# --- Application context only. Not a credential, authorizes nothing. ---
# hackpsu project; shared line +16282244223 (Garry Zhao).
CHERT_PROJECT_ID=b8c5040a-a29f-42f8-b72b-440673205c97
