# Names from echo-docs/echo-docs/docs/contracts.md §1. Placeholders only — real values go in
# agent/.env.local and web/.env.local (gitignored). Never commit or print real values.

# agent + Chert CLI (one LiveKit project)
LIVEKIT_URL=YOUR_LIVEKIT_URL
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
AGENT_NAME=remi

# agent (Realtime) and web (LLM_PROVIDER=openai)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# agent
ECHO_API_BASE=http://localhost:3000
ELDER_ID=YOUR_ELDER_ID
MOCK_CONTEXT=0
CAPTURE_AUDIO=0
TURN_SILENCE_MS=1000

# agent + web
AGENT_API_TOKEN=YOUR_SHARED_AGENT_TOKEN
DEMO_MODE=0

# web
LLM_PROVIDER=openai
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
STT_PROVIDER=none
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
EMBEDDINGS_PROVIDER=openai
DATABASE_PATH=./data/echo.db
UPLOAD_DIR=./data/uploads
DEV_TOOLS=1
NEXT_PUBLIC_FACETIME_ADDRESS=YOUR_FACETIME_ADDRESS
