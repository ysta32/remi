{
  "name": "remi-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.23.2 || ^24.0.0 || ^26.0.0" },
  "scripts": {
    "start": "node --env-file=.env.local agent.mjs start",
    "check": "for f in *.mjs scripts/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test 'test/*.test.mjs'",
    "help": "node agent.mjs --help"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35"
  }
}
