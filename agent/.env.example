# Fill these in privately. All three LiveKit values must belong to one project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# A model API key with Realtime access and available API credits.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=team-otter-video

# Optional settings (defaults in lib/config.mjs). Leave unset unless you need them.
# Backend: ECHO_API_BASE (default http://localhost:3000), AGENT_API_TOKEN (same as web), ELDER_ID (elder-hal-demo)
# Testing: GREET_ON_JOIN=1 (browser only), MOCK_CONTEXT=1, CAPTURE_AUDIO=0 to stop saving caller audio (on by default: 16 kHz mono PCM16 WAV in tmp/calls)
# Brain: CONTRACT_V2=1 (Kevin's version; backend does not support it yet)
# Voice: REALTIME_MODEL (gpt-realtime-2.1), NOISE_REDUCTION (far_field), VAD_THRESHOLD (0.6), TURN_SILENCE_MS (450), REALTIME_REASONING (minimal)
# Turn guard: ECHO_GUARD=0 to disable, BARGE_IN=0 to disable, BARGE_MIN_RMS (0.02)
# Texting saved contacts: needs CHERT_BASE_URL, CHERT_API_KEY, CHERT_PROJECT_ID; TEXT_DRY_RUN=1 logs instead of sending
# Repeat detection: REPEAT_ENGINE

# Animated avatar (lib/avatar.mjs). With both set, a LemonSlice avatar speaks and shows
# Remi's face on every call; AVATAR=off goes back to the drawn face.
LEMONSLICE_API_KEY=YOUR_LEMONSLICE_API_KEY
LEMONSLICE_AGENT_ID=YOUR_LEMONSLICE_AGENT_ID
