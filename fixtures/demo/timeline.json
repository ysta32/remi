    },
    {
      "id": "call-03",
      "startedAt": "2026-09-25T14:00:00.000Z",
      "durationS": 576,
      "status": "done",
      "summary": "Hal walked through his tomato garden this year: Big Boys along the fence and a few Romas his neighbor gave him. He explained his trick of putting crushed eggshells in the planting hole, and said the deer got more than their share in August.",
