    },
    {
      "id": "call-09",
      "startedAt": "2026-10-09T14:00:00.000Z",
      "durationS": 419,
      "status": "done",
      "summary": "Hal told about the 1977 blizzard, when he and two other men slept at the shops for two nights to keep the engines from freezing. He described the roundhouse roof giving way under the snow.",
