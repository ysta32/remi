    },
    {
      "id": "call-08",
      "startedAt": "2026-10-07T14:00:00.000Z",
      "durationS": 406,
      "status": "done",
      "summary": "Seeing the Raystown Lake photo, Hal remembered summer weekends fishing for bass with Dorothy and the kids. He said Linda caught the biggest fish one year and never let him forget it.",
      "photosShown": [
        {
          "id": "p-lake",
          "caption": "Hal and Mom at Raystown Lake, 1980"
        }
      ],
      "familyQuestion": null,
      "mood": "positive",
