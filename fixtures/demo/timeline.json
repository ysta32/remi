  "funFacts": [
    {
      "id": "ff-call-09-0",
      "text": "During the 1977 blizzard, Hal slept two nights at the shops to keep the engines running.",
      "quote": "We slept on the bench by the boiler. Nobody was going home in that.",
      "askedBy": null,
      "at": "2026-10-09T14:00:00.000Z",
      "isSimulated": true
    },
    {
      "id": "ff-call-06-0",
      "text": "Hal played trumpet in the Hollidaysburg High marching band.",
      "quote": "Third chair trumpet, and I was loud about it.",
      "askedBy": null,
      "at": "2026-10-02T14:00:00.000Z",
      "isSimulated": true
    },
    {
      "id": "ff-call-05-0",
      "text": "Hal met Dorothy at a church dance in 1964 — she stepped on his foot first.",
      "quote": "She stepped on my foot before I ever got the nerve to ask her.",
      "askedBy": "Linda",
      "at": "2026-09-30T14:00:00.000Z",
      "isSimulated": true
    },
    {
      "id": "ff-call-03-0",
      "text": "Hal puts crushed eggshells in the planting hole of every tomato plant.",
      "quote": "Eggshells in the hole, every time. My mother did it and they never split.",
      "askedBy": null,
      "at": "2026-09-25T14:00:00.000Z",
      "isSimulated": true
    },
    {
      "id": "ff-call-02-0",
      "text": "Hal's first job was sweeping floors at a bakery at 14, for 50 cents a day.",
      "quote": "Fifty cents a day and all the broken donuts I could eat.",
      "askedBy": "Linda",
      "at": "2026-09-23T14:00:00.000Z",
      "isSimulated": true
    }
  ],
